# systemd-Benutzerdienst: nach ~/.config/systemd/user/ kopieren, dann
#   systemctl --user daemon-reload && systemctl --user enable --now claude-usage
# Damit er auch ohne Anmeldung läuft: loginctl enable-linger "$USER"
[Unit]
Description=claude-usage Dashboard (127.0.0.1:7681)
After=network-online.target

[Service]
WorkingDirectory=%h/claude-usage
Environment=PORT=7681 HERMES_HOME=%h/.hermes PYTHONUNBUFFERED=1
# Optional: Environment=CLAUDE_USAGE_URL=https://dein-dashboard CLAUDE_USAGE_NTFY=https://ntfy.sh/dein-topic
ExecStart=/usr/bin/python3 %h/claude-usage/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
